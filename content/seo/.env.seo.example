# Template for content/seo/.env.seo (the real file is gitignored and never committed).
# Copy to .env.seo and fill in the values locally. Placeholders only in this tracked file.

# blog.haveninlipa.com WordPress (REST). The SEO Analyst is an Editor account: it can edit posts, never publish.
HIL_WP_URL=https://blog.haveninlipa.com
HIL_WP_USER=haven
WP_APPLICATION_PASSWORD_NAME=
WP_APPLICATION_PASSWORD=

# Code-level publish guard (SEO-DEC-009/010). Must stay false: analysts never publish.
WP_ALLOW_PUBLISH=false
